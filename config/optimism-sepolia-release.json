  "roleOwnership": [
    {
      "class": "governance",
      "description": "Protocol governance is the timelock; no EOA may hold upgrade, parameter, or treasury authority.",
      "mechanism": "ModuleRegistry.GOVERNANCE_ROLE and EmergencyControls.GOVERNANCE_ROLE are held by the timelock custody slot.",
      "holder": {
        "custodyRef": "timelock"
      }
    },
    {
      "class": "timelock",
      "description": "Minimum 172800s delay on every governed action including module replacement and governed unpause.",
      "mechanism": "Timelock custody slot executes all grants, replacements, and unpause resolutions.",
      "holder": {
        "custodyRef": "timelock"
      }
    },
    {
      "class": "guardian",
      "description": "Guardian can veto/pause but can never mutate the module registry or unpause unilaterally.",
      "mechanism": "GUARDIAN_ROLE on ModuleRegistry and PAUSER_ROLE on EvidenceRegistry.",
      "holder": {
        "custodyRef": "guardian"
      }
    },
    {
      "class": "upgradeAdmin",
      "description": "No proxy admin and no retained deployer upgrade authority; module replacement is the only upgrade path.",
      "mechanism": "ModuleRegistry replacement requires GOVERNANCE_ROLE plus a 172800s timelock; DEPLOYMENT_ROLE is renounced at finalization.",
      "holder": {
        "custodyRef": "upgradeAdmin"
      }
    },
    {
      "class": "treasury",
      "description": "Claim fees and treasury flows route to the treasury custody slot, never to the deployer.",
      "mechanism": "Claims.feeRecipient and treasury role grants.",
      "holder": {
        "custodyRef": "treasury"
      }
    },
    {
      "class": "operational",
      "description": "Pause initiation and resolution are split across two separate custody slots.",
      "mechanism": "EmergencyGatekeeper.PAUSE_INITIATOR (initiator) and PAUSE_RESOLVER (resolver) with a 3600s rewire delay.",
      "holder": {
        "custodyRef": "pauseInitiator"
      }
    }
  ],
