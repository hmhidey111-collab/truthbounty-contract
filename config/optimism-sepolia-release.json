  "commands": {
    "build": "forge build && npx hardhat compile",
    "generate": "node scripts/generateOptimismSepoliaReleasePackage.mjs --write",
    "check": "node scripts/check-optimism-sepolia-release.mjs --with-artifacts",
    "deploy": "npx hardhat run scripts/deployOptimismSepoliaRelease.ts --network optimismSepolia",
    "verify": "npx hardhat run scripts/verifyOptimismSepoliaRelease.ts --network optimismSepolia",
    "onchain": "node scripts/check-optimism-sepolia-release.mjs --onchain --rpc-url $OPTIMISM_SEPOLIA_RPC_URL",
    "reproduce": "git clean -xdf -e node_modules && npm ci && forge build && npx hardhat compile && node scripts/check-optimism-sepolia-release.mjs --with-artifacts"
  },
  "rollback": {
    "pause": "EmergencyGatekeeper.pause(scope) by PAUSE_INITIATOR \u2014 scope-bounded, never protocol-wide by default.",
    "unpause": "Governed unpause only: the timelock executes EmergencyGatekeeper.resolve(scope) after the 172800s delay; the guardian cannot unpause.",
    "roleTransfer": "Re-run the finalization grant/renounce sequence, then `forge script script/deploy/VerifyRoleRenunciation.s.sol` against the canonical address set.",
    "upgradeRollback": "Before execution call ModuleRegistry.cancelModuleReplacement(moduleId); after execution re-register the previous implementation (GOVERNANCE_ROLE + 172800s timelock). Storage layouts are frozen by storage-layouts/manifest.json.",
    "recovery": "Follow docs/runbooks/rollback.md: pause the affected scope, restore the previous release package by releaseId, replay events from the pinned eventStartCursor, and verify roles with PostDeploymentRoleCheck."
  },
  "blockers": [
    "External custody slots (bootstrapAdmin, timelock, guardian, emergencyCouncil, treasury, pauseInitiator, pauseResolver, upgradeAdmin, releasePublisher) are unassigned until the maintainer supplies Optimism Sepolia owner addresses.",
    "Deployment has not been broadcast: deployment.blockNumber, deployment.blockHash, deployment.timestamp and deployment.eventStartCursor are unset.",
    "Explorer source verification has not been executed (0 of 11 contracts verified).",
    "Read-only on-chain code/role verification has not been executed against Optimism Sepolia."
  ],
  "disclaimers": [
    "This package targets Optimism Sepolia (chain id 11155420) only. It is not a mainnet deployment and is not mainnet approval.",
    "No private key, mnemonic, API key, or production secret is embedded; deployment keys are supplied only through the operator environment.",
    "Publication requires status=published with on-chain evidence for every canonical contract."
  ]
