{
  "name": "truth_bounty_contracts",
  "version": "1.0.0",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "test": "hardhat test --network hardhatMainnet",
    "test:gas": "hardhat test --network hardhatMainnet",
    "test:gas:snapshot": "hardhat test --network hardhatMainnet",
    "test:gas:sc064": "forge test --match-path test/gas/ScenarioGasSnapshots.t.sol",
    "test:gas:sc064:gate": "node --test test/scripts/check-gas-scenarios.test.mjs",
    "snapshot:gas:sc064": "forge snapshot test/gas/ScenarioGasSnapshots.t.sol --snap .gas-snapshot.sc064",
    "check:gas:sc064": "forge snapshot test/gas/ScenarioGasSnapshots.t.sol --check .gas-snapshot.sc064 && node scripts/check-gas-scenarios.mjs",
    "test:layouts": "node --test test/scripts/validateStorageLayouts.test.mjs && npx ts-node scripts/generateStorageLayouts.ts --check",
    "test:layouts:update": "npx ts-node scripts/generateStorageLayouts.ts --update",
    "test:layouts:unit": "node --test test/scripts/validateStorageLayouts.test.mjs",
    "test:layouts:v2": "npx tsx scripts/validateStorageLayouts.ts",
    "test:fuzz": "forge test --match-contract WeightedStakingFuzzTest -vv && forge test --match-contract StakingFuzzTest -vv && forge test --match-contract IntegrationFuzzTest -vv && forge test --match-test \"test_fuzz_\" -vv",
    "test:fuzz:extended": "forge test --match-contract WeightedStakingFuzzTest --fuzz-runs 1000 -vv && forge test --match-contract StakingFuzzTest --fuzz-runs 1000 -vv",
    "test:invariant": "forge test --match-test \"invariant_\" -vv",
    "test:asset-recovery": "bash scripts/test-asset-recovery.sh && tsx --test test/scripts/asset-recovery-artifacts.test.ts",
    "test:recovery": "forge test --match-test \"test_recovery_scenario_\" -vv",
    "test:testnet": "forge test --match-path \"test/testnet/\" -vv",
    "test:reconciliation": "forge test --match-test \"test_reconciliation_\" -vv",
    "test:deployment:resume": "tsx --test test/scripts/resumable-deployment.test.ts && mocha --import=tsx test/deployment/DeploymentManifest.test.ts",
    "test:deployment": "forge test --match-test \"test_deploy_\" -vv",
    "test:coverage": "forge coverage --report lcov",
    "test:coverage:gate": "forge coverage --report lcov --report summary --skip script && npx ts-node scripts/coverage-quality-gate.ts",
    "compile": "hardhat compile",
    "compile:forge": "forge build",
    "manifest:canonical-v2": "hardhat run scripts/generateCanonicalV2Manifest.ts",
    "typechain": "hardhat compile",
    "deploy": "hardhat run scripts/deploySlashing.ts",
    "verify": "hardhat run scripts/verify.ts",
    "stake": "hardhat run scripts/stake.ts",
    "resolve-claim": "hardhat run scripts/resolveClaim.ts",
    "claim-rewards": "hardhat run scripts/claimRewards.ts",
    "fuzz:campaign": "./scripts/run-fuzz-tests.sh",
    "deploy:local": "npx hardhat ignition deploy ignition/modules/FullDeploy.ts",
    "deploy:testnet": "npx hardhat ignition deploy ignition/modules/FullDeploy.ts --network optimism_sepolia --parameters ignition/parameters/optimism_sepolia.json",
    "deploy:mainnet": "npx hardhat ignition deploy ignition/modules/FullDeploy.ts --network optimism --parameters ignition/parameters/optimism_mainnet.json",
    "deploy:token": "npx hardhat ignition deploy ignition/modules/TruthBounty.ts --network optimism_sepolia",
    "deploy:staking": "npx hardhat ignition deploy ignition/modules/Staking.ts --network optimism_sepolia",
    "deploy:rewards": "npx hardhat ignition deploy ignition/modules/Rewards.ts --network optimism_sepolia",
    "check:boundaries": "node scripts/check-dependency-boundaries.mjs",
    "test:boundaries": "node --test test/scripts/check-dependency-boundaries.test.mjs",
    "check:canonical-abi": "node scripts/canonical-abi-gates.mjs",
    "test:canonical-abi": "node --test test/scripts/canonical-abi-gates.test.mjs",
    "check:event-indexing": "node scripts/event-indexing-gates.mjs",
    "test:event-indexing": "node --test test/scripts/event-indexing-gates.test.mjs",
    "events:indexing:gas": "node scripts/event-indexing-gates.mjs --write-gas-report",
    "check:reproducibility": "node scripts/check-release-reproducibility.mjs",
    "check:release": "node scripts/check-optimism-sepolia-release.mjs",
    "build:release-artifacts": "node scripts/buildReleaseArtifacts.mjs",
    "check:release-artifacts": "node scripts/buildReleaseArtifacts.mjs --check",
    "check:release:artifacts": "node scripts/check-optimism-sepolia-release.mjs --with-artifacts --artifacts hardhat",
    "check:release:onchain": "node scripts/check-optimism-sepolia-release.mjs --onchain --rpc-url $OPTIMISM_SEPOLIA_RPC_URL",
    "release:generate": "node scripts/generateOptimismSepoliaReleasePackage.mjs --write",
    "release:promote": "node scripts/generateOptimismSepoliaReleasePackage.mjs --promote",
    "test:release": "node --test test/scripts/check-optimism-sepolia-release.test.mjs",
    "test:reproducibility": "node --test test/scripts/check-release-reproducibility.test.mjs",
    "check:deployment-sizes": "node scripts/check-deployment-sizes.mjs",
    "check:deployment-sizes:baseline": "node scripts/check-deployment-sizes.mjs --write-baseline",
    "test:deployment-sizes": "node --test test/scripts/check-deployment-sizes.test.mjs",
    "lint": "npm run check:boundaries && npm run test:boundaries && npm run check:canonical-abi && npm run test:canonical-abi && npm run check:event-indexing && npm run test:event-indexing && npm run check:release && npm run test:release && npm run test:reproducibility && npm run test:deployment-sizes",
    "sbom:release": "ts-node scripts/generateContractReleaseSbom.ts",
    "test:sbom": "hardhat test test/ContractReleaseSbom.test.ts",
    "events:snapshot": "node scripts/generate-event-snapshots.mjs",
    "events:verify": "node scripts/generate-event-snapshots.mjs --verify",
    "test:events": "forge test --match-path \"test/events/**/*.sol\" -vv",
    "test:events:drift": "forge test --match-contract EventSnapshotDriftTest -vv",
    "test:events:ordering": "forge test --match-contract EventOrderingCorrelationTest -vv",
    "test:events:legacy": "forge test --match-contract LegacyEventExclusionTest -vv"
  },
  "keywords": [
    "blockchain",
    "ethereum",
    "solidity",
    "staking",
    "fuzz-testing",
    "foundry"
  ],
  "author": "",
  "license": "ISC",
  "description": "TruthBounty smart contracts with comprehensive fuzz testing",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "^3.0.0",
    "@nomicfoundation/hardhat-ethers": "^4.2.0",
    "@nomicfoundation/hardhat-ethers-chai-matchers": "^3.0.12",
    "@nomicfoundation/hardhat-ignition": "^3.1.8",
    "@nomicfoundation/hardhat-ignition-ethers": "^3.1.6",
    "@nomicfoundation/hardhat-keystore": "^3.1.1",
    "@nomicfoundation/hardhat-mocha": "^4.0.0",
    "@nomicfoundation/hardhat-network-helpers": "^3.0.11",
    "@nomicfoundation/hardhat-toolbox-mocha-ethers": "^4.0.0",
    "@nomicfoundation/hardhat-typechain": "^3.1.1",
    "@nomicfoundation/hardhat-verify": "^3.1.2",
    "@nomicfoundation/solidity-analyzer-win32-x64-msvc": "^0.1.2",
    "@openzeppelin/hardhat-upgrades": "^4.1.0",
    "@typechain/ethers-v6": "^0.5.1",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.5",
    "chai": "^6.3.0",
    "hardhat": "^3.16.0",
    "mocha": "^12.0.3",
    "solc-0.8.28": "npm:solc@0.8.28",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15",
    "typechain": "^8.3.2",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.6.1",
    "@openzeppelin/contracts-upgradeable": "^5.6.1",
    "dotenv": "^18.0.3",
    "solc": "0.8.37"
  }
}
